{
  "name": "url-extractor-pro",
  "version": "1.2.1",
  "description": "A Chrome extension to extract URLs from web pages based on user-defined regex patterns.",
  "scripts": {
    "lint": "eslint . --ext .js",
    "format": "prettier --write . --ignore-path .prettierignore",
    "lint:fix": "eslint . --ext .js --fix",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "keywords": [
    "chrome-extension",
    "url-extractor",
    "regex"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.0.0",
    "prettier": "^2.0.0",
    "jest": "^27.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/js/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "node"
    ]
  }
}
